# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development
# Copy this file to .env for production deployment
# Never commit actual .env files to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Site URL - Used for absolute URLs, meta tags, and API calls
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application environment
# Values: development, staging, production
NODE_ENV=development

# Application port (for local development)
PORT=3000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Landing page feature flag - Controls visibility of the main landing page
# Values: true, false
# Kill switch: Set to false to disable landing page functionality
LANDING_PAGE_ENABLED=true

# Contact form feature flag - Controls contact form availability
# Values: true, false
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true

# Analytics feature flag - Controls analytics tracking
# Values: true, false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Google Analytics tracking ID (if analytics enabled)
# Format: G-XXXXXXXXXX or UA-XXXXXXXXX-X
NEXT_PUBLIC_GA_TRACKING_ID=

# Google Tag Manager container ID
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Hotjar site ID (for user behavior analytics)
# Format: numeric ID
NEXT_PUBLIC_HOTJAR_ID=

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API base URL for external services
# Local development: http://localhost:8000/api
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=

# API timeout in milliseconds
API_TIMEOUT=30000

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP configuration for contact form submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email addresses
CONTACT_EMAIL_TO=contact@your-domain.com
CONTACT_EMAIL_FROM=noreply@your-domain.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Content Security Policy mode
# Values: report-only, enforce
CSP_MODE=report-only

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Session secret for secure cookies
SESSION_SECRET=

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Image optimization settings
NEXT_PUBLIC_IMAGE_DOMAINS=your-domain.com,cdn.your-domain.com

# Cache control headers (in seconds)
STATIC_CACHE_MAX_AGE=31536000
API_CACHE_MAX_AGE=300

# Bundle analyzer (for development)
ANALYZE_BUNDLE=false

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Log level configuration
# Values: error, warn, info, debug
LOG_LEVEL=info

# Sentry DSN for error tracking
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=development

# Application insights key (Azure)
APPINSIGHTS_INSTRUMENTATIONKEY=

# =============================================================================
# DATABASE CONFIGURATION (if needed in future)
# =============================================================================

# Database connection string
DATABASE_URL=

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# REDIS CONFIGURATION (if needed for caching)
# =============================================================================

# Redis connection URL
REDIS_URL=

# Redis key prefix
REDIS_KEY_PREFIX=insurance_app:

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable development tools
NEXT_PUBLIC_DEV_TOOLS=true

# Enable React DevTools
NEXT_PUBLIC_REACT_DEVTOOLS=true

# Enable performance profiling
NEXT_PUBLIC_PERFORMANCE_PROFILING=false

# Webpack bundle analyzer
ANALYZE=false

# =============================================================================
# COMPANY INFORMATION
# =============================================================================

# Company details for meta tags and contact information
NEXT_PUBLIC_COMPANY_NAME=Your Insurance Company
NEXT_PUBLIC_COMPANY_PHONE=+1-800-123-4567
NEXT_PUBLIC_COMPANY_EMAIL=info@your-domain.com
NEXT_PUBLIC_COMPANY_ADDRESS=123 Main St, City, State 12345

# Social media links
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# =============================================================================
# SEO CONFIGURATION
# =============================================================================

# Default meta tags
NEXT_PUBLIC_DEFAULT_TITLE=Insurance Solutions | Your Insurance Company
NEXT_PUBLIC_DEFAULT_DESCRIPTION=Comprehensive insurance solutions for individuals and businesses. Get a quote today.
NEXT_PUBLIC_DEFAULT_KEYWORDS=insurance,auto insurance,home insurance,life insurance,business insurance

# Open Graph defaults
NEXT_PUBLIC_OG_IMAGE=/images/og-default.jpg
NEXT_PUBLIC_OG_SITE_NAME=Your Insurance Company

# =============================================================================
# LEGAL & COMPLIANCE
# =============================================================================

# Privacy policy and terms of service URLs
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy-policy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=/terms-of-service

# Cookie consent configuration
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Build optimization flags
NEXT_TELEMETRY_DISABLED=1
SKIP_ENV_VALIDATION=false

# Deployment platform specific
VERCEL_URL=
NETLIFY_URL=

# Health check endpoint
HEALTH_CHECK_PATH=/api/health

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup service configuration (if applicable)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30